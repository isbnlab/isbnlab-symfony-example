<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}ISBNLab Symfony example{% endblock %}</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 0 auto; padding: 1rem; color: #1f2933; line-height: 1.5; }
        header { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #e4e7eb; margin-bottom: 1.5rem; }
        header a { color: inherit; text-decoration: none; font-weight: 600; }
        form { display: flex; gap: .5rem; margin: 1rem 0; }
        input[type=text] { flex: 1; padding: .5rem; font-size: 1rem; }
        button { padding: .5rem 1rem; font-size: 1rem; }
        .book { display: grid; grid-template-columns: 10rem 1fr; gap: 1.5rem; }
        .book img { width: 100%; border-radius: 4px; }
        dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1rem; }
        dt { color: #616e7c; }
        dd { margin: 0; }
        table { border-collapse: collapse; width: 100%; font-size: .9rem; }
        th, td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid #e4e7eb; }
        .error { background: #fde8e8; border: 1px solid #f8b4b4; padding: 1rem; border-radius: 4px; }
        footer { margin-top: 3rem; font-size: .85rem; color: #616e7c; }
        @media (max-width: 40rem) { .book { grid-template-columns: 1fr; } .book img { max-width: 10rem; } }
    </style>
</head>
<body>
    <header>
        <a href="{{ path('home') }}">ISBNLab Symfony example</a>
        <small>uses <a href="https://github.com/isbnlab/isbnlab-php">isbnlab/isbnlab-php</a></small>
    </header>
    <main>{% block body %}{% endblock %}</main>
    <footer>Book data from <a href="https://www.isbnlab.com/">ISBNLab</a>.</footer>
</body>
</html>
